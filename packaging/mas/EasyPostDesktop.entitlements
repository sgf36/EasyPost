<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Mac App Store entitlements for Easy-Post Desktop (see MACOS-APP-STORE-BUILD-BRIEF §5a
  and MACOS-APP-STORE-PLAN §5). Minimum viable set for v1:

    app-sandbox                     Required for the Mac App Store.
    network.client                  Outbound HTTPS to the user's own EasyPost
                                    account, the USITC HTS endpoint, and Apple
                                    StoreKit. No network.server: the real-time
                                    push relay is out of v1 scope, so no inbound
                                    listener is needed (tracking falls back to
                                    polling under MAS_BUILD).
    files.user-selected.read-write  Label save via an NSSavePanel / Qt save
                                    dialog (user picks the location).
                                    Powerbox access covers ~/Downloads when
                                    the user picks it in the dialog — no
                                    separate downloads entitlement needed.
    print                           Printing labels (PNG/PDF/ZPL/EPL).

    cs.allow-jit                    PySide6/Qt and the pyobjc bridge generate
                                    native trampolines and use MAP_JIT on Apple
                                    Silicon. Without this, the Hardened Runtime
                                    flag silently blocks text-input integration
                                    on macOS 27+.  The direct-download
                                    entitlements already carry it.
    cs.allow-unsigned-executable-   Same code paths occasionally need W^X memory
    memory                          that predates the MAP_JIT API.  Also present
                                    in the direct-download entitlements.

  Deliberately absent: no cloudflared/tunnel (2.5.2), no arbitrary file access,
  no subprocess-spawned binaries (ioreg/MCP CLI) — the MAS build must not rely on
  any of them. cs.disable-library-validation is NOT available for sandbox/MAS.
  Add keychain-access-groups ONLY if the keyring→Keychain items fail under the
  sandbox; the app's own items usually work without an explicit group, so leave
  it out until testing proves otherwise.
-->
<plist version="1.0">
<dict>
  <!-- Must match the Mac App Store provisioning profile (team 7WA4F8P743) or the
       build is TestFlight-ineligible (altool warning 90886). Team id is public. -->
  <key>com.apple.application-identifier</key>
  <string>7WA4F8P743.com.spencerfields.easypostdesktop</string>
  <key>com.apple.developer.team-identifier</key>
  <string>7WA4F8P743</string>
  <key>com.apple.security.app-sandbox</key>
  <true/>
  <key>com.apple.security.network.client</key>
  <true/>
  <key>com.apple.security.files.user-selected.read-write</key>
  <true/>
  <key>com.apple.security.print</key>
  <true/>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
</dict>
</plist>
