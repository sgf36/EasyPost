<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap5 rescap">

  <Identity
    Name="SFields.Easy-PostDesktop"
    Publisher="CN=A7D4B6C0-27D4-4F66-82EB-82F5DD466788"
    Version="1.2.8.0"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Easy-Post Desktop</DisplayName>
    <PublisherDisplayName>SFields</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <!--
    One language, deliberately. The package carries no MRT (.pri) language
    resources — the app localises itself at runtime from its own
    app/resources/locales/*.json, so at the package level every file is
    language-neutral and en-US is simply the default. Declaring 47 languages
    here without a resources.pri to back them is what failed Store
    certification 10.3.4 ("failed to install through the Store"): the manifest
    promised resource languages the package could not provide, and Store
    deployment (stricter than Add-AppxPackage sideload) rejected it.

    This matches Microsoft's own "package a desktop app by hand" example, which
    declares a single language and relies on a generated resources.pri
    (see packaging/build_msix.py).

    The app's 47 Store *listings* (localised description + screenshots) live in
    Partner Center and are independent of this element — reducing the package
    to en-US does not remove them.
  -->
  <Resources>
    <Resource Language="en-US" />
  </Resources>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>

  <Applications>
    <Application Id="EasyPostDesktop" Executable="EasyPostDesktop\EasyPostDesktop.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Easy-Post Desktop"
        Description="Rate shopping, labels, tracking, and shipping tools for your own EasyPost account."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />

      <!--
        The MCP (AI-agent) server, exposed as an App Execution Alias so any MCP
        client (Claude Desktop, Cursor, VS Code, ...) can launch it by name on
        PATH as `easypost-mcp.exe`. This gives the Store build agent parity with
        the direct download: the alias is stable across Store updates (the
        versioned WindowsApps install path is not) and runs the helper with this
        package's identity, so its keyring and app data match the GUI's.

        The alias lives on the single, visible main Application, and its own
        Executable attribute points at the console helper. It is deliberately
        NOT a second, hidden (AppListEntry="none") Application: the Store
        classifies a hidden app as "headless" and rejects the package without a
        HeadlessAppBypass waiver ("You don't have permission to create a
        headless app"). One visible app plus an alias to the helper avoids that.
      -->
      <Extensions>
        <uap5:Extension Category="windows.appExecutionAlias" Executable="EasyPostDesktop\easypost-mcp.exe" EntryPoint="Windows.FullTrustApplication">
          <uap5:AppExecutionAlias>
            <uap5:ExecutionAlias Alias="easypost-mcp.exe" />
          </uap5:AppExecutionAlias>
        </uap5:Extension>
      </Extensions>
    </Application>
  </Applications>
</Package>
