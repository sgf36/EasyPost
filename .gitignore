.venv/
__pycache__/
*.pyc
build/
dist/
*.spec.bak
.pytest_cache/

# Never commit signing keys.
#
# This said so before it was true: it covered *.pem and *PRIVATE-KEY* and
# nothing else, while the actual Apple signing material is .p8, .p12, .key,
# .cer and provisioning profiles. None of it lives in this repository today —
# but this repository is public, and a `git add -A` has already swept 14 MB of
# listing zips into it once (see the commit that untracked them). The cost of
# that mistake with an App Store Connect key in the tree is not recoverable by
# untracking it afterwards.
*.pem
*PRIVATE-KEY*
*.p8
*.p12
*.key
*.cer
*.csr
*.mobileprovision
*.provisionprofile

# Worker dev secrets. `wrangler dev` reads .dev.vars from the Worker's own
# directory, and it holds live values — the Paddle webhook secret, the Paddle
# API key, the licence signing key, the Resend key.
#
# Only server/easypost-mobile-proxy ignored its own; the licence webhook and the
# MCP relay did not, so a .dev.vars created in either would have been offered up
# by `git add -A` in a public repository. None has ever been committed — checked
# across every branch — so this closes a gap rather than cleaning up a leak.
# Rooted at the repository so it covers Workers added later too.
**/.dev.vars
**/.dev.vars.*

# Build-variant flags (created at package time, never committed)
app/resources/license_required.flag
app/resources/mcp_supported.flag
app/resources/store_build.flag
app/resources/mas_build.flag

# Locally downloaded build artifacts — never committed
dist-download/

# Generated listing-import package (rebuild with build_listing_import.py)
store_assets/EasyPost-Store-Listings-IMPORT-v2*/
store_assets/EasyPost-Store-Listings-IMPORT-v2-stage2.csv

# Staged Store package (71MB, rebuilt by packaging/build_msix.py)
store_assets/submission/

# esbuild output produced when deploying the Worker by hand
server/paddle-license-webhook-worker/build-bundle*.js
server/paddle-license-webhook-worker/bundle*.b64

# wrangler local state (any worker)
**/.wrangler/

# Internal marketing drafts — not for the public repo
marketing/

# Listing packages are rebuilt from store_assets/ contents; the zips are
# duplicates of the folders beside them and only bloat a public repository.
store_assets/*.zip
